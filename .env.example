# ---------------------------------------------------------------------------
# Contact form delivery (optional but recommended)
#
# Without these the enquiry form still validates, but instead of sending it
# tells the visitor to email or call directly. Set all three to turn it on.
#
# 1. Create an account at https://resend.com and verify anantaagreenenergy.com
# 2. Create an API key and paste it below
# 3. Redeploy
# ---------------------------------------------------------------------------

RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=website@anantaagreenenergy.com
ENQUIRY_TO_EMAIL=info@anantaagreenenergy.com

# ---------------------------------------------------------------------------
# Google Search Console (optional)
#
# 1. Go to https://search.google.com/search-console, add the
#    anantaagreenenergy.com property, choose "HTML tag" verification
# 2. It shows a meta tag like <meta name="google-site-verification"
#    content="abc123..." /> — paste just the content value below
# 3. Redeploy, then click Verify in Search Console
# ---------------------------------------------------------------------------

GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Google Analytics 4 (optional)
#
# 1. Create a GA4 property at https://analytics.google.com for
#    anantaagreenenergy.com and copy its Measurement ID (starts with G-)
# 2. Paste it below and redeploy
# ---------------------------------------------------------------------------

GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Vercel Web Analytics (optional, no env var needed)
#
# The @vercel/analytics package is already wired in. To start collecting
# data, enable Web Analytics for this project in the Vercel dashboard:
# Project -> Analytics tab -> Enable.
# ---------------------------------------------------------------------------
